{
  "name": "@janguenzel/authjs-authorization",
  "version": "0.2.0",
  "description": "Flexible RBAC + ABAC authorization layer for Auth.js (NextAuth v5)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./nextjs": {
      "types": "./dist/integrations/nextjs/index.d.ts",
      "import": "./dist/integrations/nextjs/index.js",
      "require": "./dist/integrations/nextjs/index.cjs"
    },
    "./prisma": {
      "types": "./dist/adapters/prisma.d.ts",
      "import": "./dist/adapters/prisma.js",
      "require": "./dist/adapters/prisma.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "release": "release-it"
  },
  "keywords": [
    "authorization",
    "rbac",
    "abac",
    "auth.js",
    "next-auth",
    "nextjs",
    "access-control",
    "json-logic",
    "prisma",
    "typescript"
  ],
  "author": "Jan Günzel <npm@jan-guenzel.de>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janguenzel/authjs-authorization.git"
  },
  "homepage": "https://github.com/janguenzel/authjs-authorization#readme",
  "bugs": {
    "url": "https://github.com/janguenzel/authjs-authorization/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "peerDependencies": {
    "@prisma/client": ">=5.0.0",
    "next": ">=14.0.0",
    "next-auth": ">=5.0.0-beta.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "@prisma/client": {
      "optional": true
    }
  },
  "dependencies": {
    "json-logic-js": "^2.0.2"
  },
  "devDependencies": {
    "@prisma/client": "^6.0.0",
    "@types/json-logic-js": "^2.0.6",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "next": "^15.0.0",
    "next-auth": "5.0.0-beta.31",
    "prisma": "^6.0.0",
    "release-it": "^20.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
